# Copy to .env and fill in. NEVER commit .env.

# --- safety ---
DRY_RUN=true          # keep true while developing; false only on the posting machine
AUTO_APPROVE=false

# --- LLM ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- ingest ---
MAX_SOURCE_MINUTES=90
YTDLP_COOKIES_FROM_BROWSER=   # e.g. chrome, if YouTube blocks downloads

# --- analyze / render ---
CLIPS_PER_VIDEO=5
CANDIDATES=15
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60
WHISPER_MODEL=small   # base if too slow
LAYOUT=blur
MUSIC_MODE=in_app

# --- captions ---
BASE_HASHTAGS=#gta6 #gta #gaming

# --- publish ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
IG_APP_ID=
IG_APP_SECRET=
ENABLED_PLATFORMS=tiktok,instagram
POST_INTERVAL_MINUTES=90
POSTING_WINDOW=10:00-23:30
DAILY_CAP_TIKTOK=6
DAILY_CAP_INSTAGRAM=5
